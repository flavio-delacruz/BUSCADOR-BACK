# Copia a .env. Nunca publiques credenciales.
PORT=4000
# Opcional. Deja vacío para trabajar con datos de demostración.
MONGODB_URI=
# Para consumo web, coloca el origen exacto. Clientes nativos no envían Origin.
CORS_ORIGIN=

# Sincronización opcional, DESACTIVADA hasta configurar las tres variables.
# Genera un token de 32 bytes (hex, 64 caracteres) con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_API_TOKEN=
# Genera una clave AES-256 en base64 con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SYNC_ENCRYPTION_KEY=
